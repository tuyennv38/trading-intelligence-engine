{
  "openapi": "3.0.4",
  "info": {
    "title": "TradingIntelligenceEngine.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/market-analysis/analyze": {
      "post": {
        "tags": [
          "MarketAnalysis"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarketAnalysisRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/MarketAnalysisRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/MarketAnalysisRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CandleDto": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "open": {
            "type": "number",
            "format": "double"
          },
          "high": {
            "type": "number",
            "format": "double"
          },
          "low": {
            "type": "number",
            "format": "double"
          },
          "close": {
            "type": "number",
            "format": "double"
          },
          "volume": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "MarketAnalysisRequestDto": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "nullable": true
          },
          "timeframe": {
            "type": "string",
            "nullable": true
          },
          "candles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CandleDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "MarketAnalysis"
    }
  ]
}